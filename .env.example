# Server Environment Variables (Keep SECRET - never commit real keys to Git!)
GEMINI_API_KEY=your_gemini_api_key_here
PORT=3000

# Client Firebase Configuration (Optional: can also be configured via environment variables)
# If firebase-applet-config.json is kept secret/gitignored, you can set these in your hosting dashboard:
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_DATABASE_ID=ai-studio-nutrimind-0ada7ce5-c6c7-4e11-80f0-64a9c1c9ba4b
