rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profile document: strictly scoped to the authenticated user
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Disallow querying across all user profiles
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);

      // User's meals subcollection
      match /meals/{mealId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(mealId);
        allow delete: if isOwner(userId) && isValidId(mealId);
      }

      // User's conversations subcollection
      match /conversations/{conversationId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(conversationId);
        allow delete: if isOwner(userId) && isValidId(conversationId);

        // Messages in conversation
        match /messages/{messageId} {
          allow get, list: if isOwner(userId);
          allow create, update: if isOwner(userId) && isValidId(messageId);
          allow delete: if isOwner(userId) && isValidId(messageId);
        }
      }
    }
  }
}
